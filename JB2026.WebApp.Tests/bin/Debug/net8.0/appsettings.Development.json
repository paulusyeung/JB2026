      },
      "jobs": {
        "DisplayName": "Jobs",
        "Enabled": true,
        "Prefixes": [ "/jobs" ]
      },
      "quotations": {
        "DisplayName": "Quotations",
        "Enabled": true,
        "Prefixes": [ "/quotations" ]
      },
      "forms": {
        "DisplayName": "Forms",
        "Enabled": true,
        "Prefixes": [ "/login" ]
      },
      "editor": {
        "DisplayName": "Rich Text",
        "Enabled": true,
        "Prefixes": [ "/editor" ]
      },
      "scheduler": {
        "DisplayName": "Scheduler",
