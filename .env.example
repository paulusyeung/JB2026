# =============================================================================
# JB2026 Docker Compose — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# The .env file is loaded automatically by docker compose.
# =============================================================================

# --- Docker Hub ---------------------------------------------------------------
# Your Docker Hub username (used for pulling/pushing images)
DOCKER_HUB_USERNAME=youruser

# Image tag — pin a semver/SHA in production (avoid relying on :latest for rollback).
IMAGE_TAG=latest

# --- Ports --------------------------------------------------------------------
# FRONTEND_PORT is the public HTTP entry (put TLS in front for production).
# BACKEND_PORT is bound to 127.0.0.1 only in docker-compose.yml — browsers should
# use the frontend /api/ proxy, not hit the API port directly from other hosts.
FRONTEND_PORT=80
BACKEND_PORT=8080

# Nginx upstream inside the compose network (usually leave as default).
# BACKEND_URL=http://backend:8080

# --- Database -----------------------------------------------------------------
# Required: Connection string for the primary SQL Server database.
# Example for external SQL Server:
DB_CONNECTION_STRING=Server=sql.example.com;Database=JB2026;User Id=jb2026;Password=ChangeMe;TrustServerCertificate=True

# Example for local SQL Server (if you uncomment the sql-server service):
# DB_CONNECTION_STRING=Server=sql-server;Database=JB2026;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True

# JWT configuration — the key MUST be at least 256 bits (32+ chars) in production.
JWT_KEY=change-this-to-a-secure-random-key-at-least-32-chars
JWT_ISSUER=jb2026-api
JWT_AUDIENCE=jb2026-clients

# --- Swagger / OpenAPI --------------------------------------------------------
# Production default is off. Set true only on trusted networks (LAN), then open
# /swagger via SSH tunnel (backend is loopback-bound) or a temporary public port:
#   ssh -L 8080:127.0.0.1:8080 deploy@<server>
#   http://localhost:8080/swagger
SWAGGER_ENABLED=false

# --- CORS ---------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API directly.
# Production: set your real public origin(s), e.g. https://app.example.com
# http://localhost is only for local smoke tests.
# CORS_ALLOWED_ORIGINS=https://app.example.com,http://192.168.1.50:3000
CORS_ALLOWED_ORIGINS=http://localhost

# --- External Services (optional) ---------------------------------------------
# Leave blank to use in-memory defaults.
# These are used by the backend for billing, CRM, AI, document management, etc.

# Invoice Ninja / Billing integration
BILLING_BASE_URL=

# Twenty CRM
TWENTY_CRM_BASE_URL=

# Ollama (local LLM for AI summaries)
# OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=

# Paperless-ngx (document management)
PAPERLESS_NGX_BASE_URL=

# --- Uploaded attachments (Windows SMB share) --------------------------------
# Host path where the Windows share //10.0.1.11/JB5 is mounted via /etc/fstab
# (see ops/docker/README.md §7.5, Option A). Bind-mounted into the backend at
# /data/attachments and used for LegacyFiles:CloudDiskRoot / SmlFileRoot.
# Required for CloudDisk / job & product uploads to work.
ATTACHMENTS_HOST_PATH=/mnt/jb5

# --- Local SQL Server (optional) ----------------------------------------------
# Only needed if you uncomment the sql-server service in docker-compose.yml
SQL_SA_PASSWORD=YourStrong!Passw0rd
SQL_PORT=1433