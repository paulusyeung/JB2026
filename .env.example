# =============================================================================
# JB2026 Docker Compose — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# The .env file is loaded automatically by docker compose.
# =============================================================================

# --- Docker Hub ---------------------------------------------------------------
# Your Docker Hub username (used for pulling/pushing images)
DOCKER_HUB_USERNAME=youruser

# Image tag — default is "latest", or pin to a version like "1.0.0"
IMAGE_TAG=latest

# --- Ports --------------------------------------------------------------------
# Host ports to expose. Change these if 80 or 8080 are already in use.
FRONTEND_PORT=80
BACKEND_PORT=8080

# --- Database -----------------------------------------------------------------
# Required: Connection string for the primary SQL Server database.
# Example for external SQL Server:
DB_CONNECTION_STRING=Server=sql.example.com;Database=JB2026;User Id=jb2026;Password=ChangeMe;TrustServerCertificate=True

# Example for local SQL Server (if you uncomment the sql-server service):
# DB_CONNECTION_STRING=Server=sql-server;Database=JB2026;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True

# JWT configuration — the key MUST be at least 256 bits (32+ chars) in production.
JWT_KEY=change-this-to-a-secure-random-key-at-least-32-chars
JWT_ISSUER=jb2026-api
JWT_AUDIENCE=jb2026-clients

# --- CORS ---------------------------------------------------------------------
# Comma-separated list of allowed origins for the backend API.
# If the frontend Nginx proxies /api/ (same-origin), you can leave this as-is.
# Add more origins if you access the API directly (mobile app, other services):
# CORS_ALLOWED_ORIGINS=http://localhost,https://app.example.com,http://192.168.1.50:3000
CORS_ALLOWED_ORIGINS=http://localhost

# --- External Services (optional) ---------------------------------------------
# Leave blank to use in-memory defaults.
# These are used by the backend for billing, CRM, AI, document management, etc.

# Invoice Ninja / Billing integration
BILLING_BASE_URL=

# Twenty CRM
TWENTY_CRM_BASE_URL=

# Ollama (local LLM for AI summaries)
# OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=

# Paperless-ngx (document management)
PAPERLESS_NGX_BASE_URL=

# --- Local SQL Server (optional) ----------------------------------------------
# Only needed if you uncomment the sql-server service in docker-compose.yml
SQL_SA_PASSWORD=YourStrong!Passw0rd
SQL_PORT=1433