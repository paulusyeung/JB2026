{
  "ConnectionStrings": {
    "Primary": "__set_via_secret_provider__"
  },
  "UiModernization": {
    "CacheTtlSeconds": 60,
    "LegacyBaseUrl": "",
    "Slices": {
      "dashboard": {
        "DisplayName": "Dashboard",
        "Enabled": true,
        "Prefixes": [ "/dashboard" ]
      },
      "jobs": {
        "DisplayName": "Jobs",
        "Enabled": true,
        "Prefixes": [ "/jobs" ]
      },
      "quotations": {
        "DisplayName": "Quotations",
        "Enabled": true,
        "Prefixes": [ "/quotations" ]
      },
      "forms": {
        "DisplayName": "Forms",
        "Enabled": true,
        "Prefixes": [ "/login" ]
      },
      "editor": {
        "DisplayName": "Rich Text",
        "Enabled": false,
        "Prefixes": [ "/editor" ]
      },
      "scheduler": {
        "DisplayName": "Scheduler",
        "Enabled": false,
        "Prefixes": [ "/scheduler" ]
      },
      "job-order": {
        "DisplayName": "Job Order",
        "Enabled": false,
        "Prefixes": [ "/joborder", "/job-order" ]
      },
      "sml": {
        "DisplayName": "SML",
        "Enabled": false,
        "Prefixes": [ "/sml" ]
      },
      "stock": {
        "DisplayName": "Stock",
        "Enabled": false,
        "Prefixes": [ "/stock" ]
      },
      "reports": {
        "DisplayName": "Reports",
        "Enabled": false,
        "Prefixes": [ "/reports" ]
      },
      "admin": {
        "DisplayName": "Admin",
        "Enabled": false,
        "Prefixes": [ "/admin" ]
      },
      "public": {
        "DisplayName": "Public",
        "Enabled": false,
        "Prefixes": [ "/public" ]
      },
      "settings": {
        "DisplayName": "Settings",
        "Enabled": false,
        "Prefixes": [ "/settings" ]
      },
      "help": {
        "DisplayName": "Help",
        "Enabled": false,
        "Prefixes": [ "/help" ]
      }
    }
  },
  "JB2026": {
    "Environment": {
      "DeploymentRing": "Production",
      "SecretProvider": "EnvironmentVariables"
    },
    "Secrets": {
      "ConnectionStringKey": "ConnectionStrings__Primary"
    },
    "Observability": {
      "ServiceName": "JB2026.WebApp",
      "OtlpEndpoint": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
