server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;

    # -------------------------------------------------------------------------
    # HARDENING: baseline security headers (CSP left off — tune per app needs)
    # -------------------------------------------------------------------------
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # -------------------------------------------------------------------------
    # HARDENING: gzip for text assets (Nginx default mime.types covers these)
    # -------------------------------------------------------------------------
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_proxied any;
    gzip_vary on;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml
        font/woff2;

    # Docker's embedded DNS resolver — required because the upstream
    # (BACKEND_URL) is injected as a variable and resolved at request time.
    resolver 127.0.0.11 ipv6=off;

    # Proxy API requests to the backend. BACKEND_URL is substituted at
    # container start from the environment (default: http://backend:8080
    # for the bundled docker-compose stack).
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 30s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # HARDENING: expose backend liveness via the public frontend so probes
    # do not need the (loopback-only) backend host port.
    location = /healthz {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 5s;
    }

    # HARDENING: long-cache hashed Vite build assets under /app/assets/.
    location /app/assets/ {
        expires 7d;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Serve the Vue SPA at /app/ with client-side routing fallback.
    # Any path that doesn't match a real file is rewritten to index.html
    # so vue-router's createWebHistory('/app/') handles it client-side.
    location /app/ {
        # HARDENING: do not cache the HTML shell so deploys pick up new asset hashes.
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        try_files $uri $uri/ /app/index.html;
    }

    # Redirect bare /app (no trailing slash) to /app/ so the router base
    # path is correct and assets load from the right directory.
    location = /app {
        return 301 /app/;
    }

    # Root — redirect to the SPA entry point.
    location = / {
        return 302 /app/;
    }
}
