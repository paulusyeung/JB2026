{
  "ConnectionStrings": {
    "Primary": "__set_via_secret_provider__"
  },
  "JB2026": {
    "Environment": {
      "DeploymentRing": "Production",
      "SecretProvider": "EnvironmentVariables"
    },
    "Secrets": {
      "ConnectionStringKey": "ConnectionStrings__Primary"
    },
    "Observability": {
      "ServiceName": "JB2026.Api",
      "OtlpEndpoint": ""
    }
  },
  "Jwt": {
    "Key": "__set_via_secret_provider__",
    "Issuer": "jb2026-api",
    "Audience": "jb2026-clients",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 30
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "DefaultModel": "llama3",
    "TimeoutSeconds": 30
  },
  "Billing": {
    "InvoiceNinja": {
      "ApiKey": "50IBTQoJoGb5ALZRZFbUaacqQO615GHh6uS7XNE6GQePSInqCBpxbOEsz2ZUmKUo",
      "BaseUrl": "http://10.0.1.15:8086/api/v1",
      "CustomFields": {
        "ClientBillTo": "custom_value1",
        "ClientShipTo": "custom_value2",
        "ClientFax": "client3",
        "ContactFullName": "contact.custom1",
        "ProductUnit": "custom_value1",
        "ProductPoNo": "custom_value2",
        "InvoiceJobNo": "custom_value1"
      },
      "HttpClientTimeoutSeconds": 30,
      "RetryMaxAttempts": 3,
      "RetryBackoffMultiplier": 2.0
