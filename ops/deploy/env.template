# =============================================================================
# JB2026 production secrets — /etc/jb2026/env
# =============================================================================
# This template is safe to commit. Replace the values with real ones on the
# server (provision-server.sh copies it to /etc/jb2026/env, chmod 640).
# The systemd unit reads it via EnvironmentFile=. Do NOT commit real values.
# =============================================================================

# --- Database (required) -----------------------------------------------------
# External SQL Server (already running on a separate server).
ConnectionStrings__Primary=Server=sql.example.com,1433;Database=JB2026;User Id=jb2026;Password=CHANGE_ME;TrustServerCertificate=True

# --- JWT (required, key must be >= 32 characters) ----------------------------
Jwt__Key=change-this-to-a-secure-random-key-at-least-32-characters
Jwt__Issuer=jb2026-api
Jwt__Audience=jb2026-clients

# --- Optional external services (leave blank to use in-memory/defaults) ------
Billing__BaseUrl=
TwentyCrm__BaseUrl=
Ollama__BaseUrl=
PaperlessNgx__BaseUrl=

# --- Legacy file storage (job attachments, CloudDisk, product pictures) ------
# These point at the mounted external shared folder (see mount-storage.sh).
# Attachment upload FAILS if FileAgentRoot is empty.
LegacyFiles__FileAgentRoot=/srv/jb2026/attachments
LegacyFiles__InBox=/srv/jb2026/attachments
LegacyFiles__CloudDiskRoot=/srv/jb2026/cloud
LegacyFiles__ProductPictureRoot=/srv/jb2026/products
LegacyFiles__SmlFileRoot=/srv/jb2026/sml
LegacyFiles__DropBox=/srv/jb2026/dropbox
LegacyFiles__OutBox=/srv/jb2026/outbox
LegacyFiles__WorkFolder=/srv/jb2026/work
